# Base URL of the FastAPI backend (personal/suan/appserver).
#
# NOTE: @quasar/app-vite exposes client-side env vars under the QCLI_ prefix
# (not Vite's usual VITE_ prefix) — see quasar.config.js -> build -> env.
#
# Local dev: run the backend from personal/suan/appserver with
#   uvicorn app.main:app --host 0.0.0.0 --port 5000 --reload
# On the server behind NGINX, use your assigned http://<server>:<port>/<path>/ instead,
# e.g. QCLI_API_BASE_URL=http://<server>:3301/appdev1/
QCLI_API_BASE_URL=http://127.0.0.1:5000/
