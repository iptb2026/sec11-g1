# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored: never commit the real password or key.

DB_USER=admin
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=catarig

# Signs every login token. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
